<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClinicManager.ViewModels.StaffMembers"
             xmlns:models="using:ClinicManager.Models"
             x:Class="ClinicManager.Views.StaffMembers.EditStaffMemberView"
             x:DataType="vm:EditStaffMemberViewModel">

    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Classes="form-stack"
                        Spacing="24"
                        MaxWidth="1000"
                        HorizontalAlignment="Left">

                <TextBlock Classes="main-page-description"
                           Text="Personaldaten bearbeiten oder das Beschäftigungsverhältnis beenden." />

                <!-- Bearbeitungsformular -->
                <StackPanel IsVisible="{Binding IsStaffMemberLoaded}"
                            Spacing="24">

                    <!-- Stammdaten -->
                    <StackPanel Spacing="16">

                        <TextBlock Classes="form-section-title"
                                   Text="Stammdaten" />

                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="26"
                              RowSpacing="18">

                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                <TextBlock Classes="form-label" Text="Vorname" />
                                <TextBox Classes="form-input" Text="{Binding FirstName, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                <TextBlock Classes="form-label" Text="Nachname" />
                                <TextBox Classes="form-input" Text="{Binding LastName, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                                <TextBlock Classes="form-label" Text="Geburtsdatum" />
                                <DatePicker Classes="form-input" SelectedDate="{Binding DateOfBirth, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                <TextBlock Classes="form-label" Text="Titel" />
                                <TextBox Classes="form-input" Text="{Binding Title, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
                                <TextBlock Classes="form-label" Text="Rolle" />
                                <ComboBox Classes="form-input"
                                          ItemsSource="{Binding RoleOptions}"
                                          SelectedItem="{Binding Role, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                                <TextBlock Classes="form-label" Text="Telefon" />
                                <TextBox Classes="form-input" Text="{Binding PhoneNumber, Mode=TwoWay}" />
                            </StackPanel>

                        </Grid>

                    </StackPanel>

                    <!-- Adresse -->
                    <StackPanel Spacing="16">

                        <TextBlock Classes="form-section-title"
                                   Text="Adresse" />

                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="26"
                              RowSpacing="18">

                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                <TextBlock Classes="form-label" Text="Straße" />
                                <TextBox Classes="form-input" Text="{Binding Street, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                <TextBlock Classes="form-label" Text="Hausnummer" />
                                <TextBox Classes="form-input" Text="{Binding StreetNumber, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                                <TextBlock Classes="form-label" Text="PLZ" />
                                <TextBox Classes="form-input" Text="{Binding PostalCode, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                <TextBlock Classes="form-label" Text="Ort" />
                                <TextBox Classes="form-input" Text="{Binding City, Mode=TwoWay}" />
                            </StackPanel>

                        </Grid>

                    </StackPanel>

                    <!-- Beschäftigung -->
                    <StackPanel Spacing="16">

                        <TextBlock Classes="form-section-title"
                                   Text="Beschäftigung" />

                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="26"
                              RowSpacing="18">

                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                <TextBlock Classes="form-label" Text="Eintrittsdatum" />
                                <DatePicker Classes="form-input"
                                            SelectedDate="{Binding EmploymentStartDate, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                <TextBlock Classes="form-label" Text="Austrittsdatum" />
                                <DatePicker Classes="form-input"
                                            SelectedDate="{Binding EmploymentEndDate, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                                <TextBlock Classes="form-label" Text="Station" />
                                <TextBox Classes="form-input"
                                         Text="{Binding StationId, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                <TextBlock Classes="form-label" Text="Büro" />
                                <TextBox Classes="form-input"
                                         Text="{Binding OfficeId, Mode=TwoWay}" />
                            </StackPanel>

                        </Grid>

                    </StackPanel>

                    <Button Classes="btn btn-prim"
                            Content="Änderungen speichern"
                            Command="{Binding SaveStaffMemberCommand}" />

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

        <!-- Status Overlay -->
        <Grid Classes="status-overlay"
              IsVisible="{Binding IsStatusVisible}">

            <Border Classes="status-dialog status-success"
                    IsVisible="{Binding IsSuccess}">
                <StackPanel Spacing="20">
                    <TextBlock Classes="status-success-text"
                               Text="{Binding StatusMessage}"
                               TextAlignment="Center" />
                    <Button Classes="btn btn-prim"
                            Content="OK"
                            HorizontalAlignment="Center"
                            Command="{Binding CloseStatusCommand}" />
                </StackPanel>
            </Border>

            <Border Classes="status-dialog status-error"
                    IsVisible="{Binding IsError}">
                <StackPanel Spacing="20">
                    <TextBlock Classes="status-error-text"
                               Text="{Binding StatusMessage}"
                               TextAlignment="Center" />
                    <Button Classes="btn btn-prim"
                            Content="OK"
                            HorizontalAlignment="Center"
                            Command="{Binding CloseStatusCommand}" />
                </StackPanel>
            </Border>

        </Grid>

    </Grid>

</UserControl>
