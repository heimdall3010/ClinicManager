<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClinicManager.ViewModels.StaffMembers"
             x:Class="ClinicManager.Views.StaffMembers.AddStaffMemberView"
             x:DataType="vm:AddStaffMemberViewModel">

    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Classes="form-stack"
                        Spacing="24"
                        MaxWidth="1000"
                        HorizontalAlignment="Left">

                <TextBlock Classes="main-page-description"
                           Text="Neues Personal mit Stammdaten und Beschäftigungsinformationen anlegen." />

                <!-- Stammdaten -->
                <StackPanel Spacing="16">

                    <TextBlock Classes="form-section-title"
                               Text="Stammdaten" />

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="26"
                          RowSpacing="18">

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                            <TextBlock Classes="form-label" Text="Vorname" />
                            <TextBox Classes="form-input"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding FirstName, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                            <TextBlock Classes="form-label" Text="Nachname" />
                            <TextBox Classes="form-input"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding LastName, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                            <TextBlock Classes="form-label" Text="Geburtsdatum" />
                            <DatePicker Classes="form-input"
                                        HorizontalAlignment="Stretch"
                                        SelectedDate="{Binding DateOfBirth, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                            <TextBlock Classes="form-label" Text="Titel" />
                            <TextBox Classes="form-input"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding Title, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
                            <TextBlock Classes="form-label" Text="Rolle" />
                            <ComboBox Classes="form-input"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding RoleOptions}"
                                      SelectedItem="{Binding Role, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                            <TextBlock Classes="form-label" Text="Telefon" />
                            <TextBox Classes="form-input"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding PhoneNumber, Mode=TwoWay}" />
                        </StackPanel>

                    </Grid>

                </StackPanel>

                <!-- Adresse -->
                <StackPanel Spacing="16">

                    <TextBlock Classes="form-section-title"
                               Text="Adresse" />

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="26"
                          RowSpacing="18">

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                            <TextBlock Classes="form-label" Text="Straße" />
                            <TextBox Classes="form-input"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding Street, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                            <TextBlock Classes="form-label" Text="Hausnummer" />
                            <TextBox Classes="form-input"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding StreetNumber, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                            <TextBlock Classes="form-label" Text="PLZ" />
                            <TextBox Classes="form-input"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding PostalCode, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                            <TextBlock Classes="form-label" Text="Ort" />
                            <TextBox Classes="form-input"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding City, Mode=TwoWay}" />
                        </StackPanel>

                    </Grid>

                </StackPanel>

                <!-- Beschäftigung -->
                <StackPanel Spacing="16">

                    <TextBlock Classes="form-section-title"
                               Text="Beschäftigung" />

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="26"
                          RowSpacing="18">

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                            <TextBlock Classes="form-label" Text="Eintrittsdatum" />
                            <DatePicker Classes="form-input"
                                        HorizontalAlignment="Stretch"
                                        SelectedDate="{Binding EmploymentStartDate, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                            <TextBlock Classes="form-label" Text="Station" />
                            <TextBox Classes="form-input"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding StationId, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                            <TextBlock Classes="form-label" Text="Büro" />
                            <TextBox Classes="form-input"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding OfficeId, Mode=TwoWay}" />
                        </StackPanel>

                    </Grid>

                </StackPanel>

                <Button Classes="btn btn-prim"
                        Content="Personal aufnehmen"
                        Command="{Binding SaveStaffMemberCommand}" />

            </StackPanel>

        </ScrollViewer>

        <!-- Status Overlay -->
        <Grid Classes="status-overlay"
              IsVisible="{Binding IsStatusVisible}">

            <Border Classes="status-dialog status-success"
                    IsVisible="{Binding IsSuccess}">

                <StackPanel Spacing="20">

                    <TextBlock Classes="status-success-text"
                               Text="{Binding StatusMessage}"
                               TextAlignment="Center" />

                    <Button Classes="btn btn-prim"
                            Content="OK"
                            HorizontalAlignment="Center"
                            Command="{Binding CloseStatusCommand}" />

                </StackPanel>

            </Border>

            <Border Classes="status-dialog status-error"
                    IsVisible="{Binding IsError}">

                <StackPanel Spacing="20">

                    <TextBlock Classes="status-error-text"
                               Text="{Binding StatusMessage}"
                               TextAlignment="Center" />

                    <Button Classes="btn btn-prim"
                            Content="OK"
                            HorizontalAlignment="Center"
                            Command="{Binding CloseStatusCommand}" />

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>
