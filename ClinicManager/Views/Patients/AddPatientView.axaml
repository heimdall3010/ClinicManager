<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClinicManager.ViewModels.Patients"
             x:Class="ClinicManager.Views.Patients.AddPatientView"
             x:DataType="vm:AddPatientViewModel">

    <Grid>

        <!-- ====================================== -->
        <!-- Formular                               -->
        <!-- ====================================== -->

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Classes="form-stack"
                        Spacing="24"
                        MaxWidth="1000"
                        HorizontalAlignment="Left">

                <TextBlock Classes="main-page-description"
                           Text="Neuen Patienten mit Stammdaten und Aufnahmeinformationen anlegen." />


                <!-- ====================================== -->
                <!-- Stammdaten                             -->
                <!-- ====================================== -->

                <StackPanel Spacing="16">

                    <TextBlock Classes="form-section-title"
                               Text="Stammdaten" />

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="26"
                          RowSpacing="18">

                        <!-- Vorname -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    Spacing="6">

                            <TextBlock Classes="form-label"
                                       Text="Vorname" />

                            <TextBox Classes="form-input"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding FirstName, Mode=TwoWay}" />

                        </StackPanel>


                        <!-- Nachname -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    Spacing="6">

                            <TextBlock Classes="form-label"
                                       Text="Nachname" />

                            <TextBox Classes="form-input"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding LastName, Mode=TwoWay}" />

                        </StackPanel>


                        <!-- Geburtsdatum -->
                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Spacing="6">

                            <TextBlock Classes="form-label"
                                       Text="Geburtsdatum" />

                            <DatePicker Classes="form-input"
                                        HorizontalAlignment="Stretch"
                                        SelectedDate="{Binding DateOfBirth, Mode=TwoWay}" />

                        </StackPanel>


                        <!-- Geschlecht -->
                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Spacing="6">

                            <TextBlock Classes="form-label"
                                       Text="Geschlecht" />

                            <ComboBox Classes="form-input"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding GenderOptions}"
                                      SelectedItem="{Binding Gender, Mode=TwoWay}" />

                        </StackPanel>


                        <!-- Versichertennummer -->
                        <StackPanel Grid.Row="2"
                                    Grid.Column="0"
                                    Spacing="6">

                            <TextBlock Classes="form-label"
                                       Text="Versichertennummer" />

                            <TextBox Classes="form-input"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding InsuranceNumber, Mode=TwoWay}" />

                        </StackPanel>


                        <!-- Telefon -->
                        <StackPanel Grid.Row="2"
                                    Grid.Column="1"
                                    Spacing="6">

                            <TextBlock Classes="form-label"
                                       Text="Telefon" />

                            <TextBox Classes="form-input"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding PhoneNumber, Mode=TwoWay}" />

                        </StackPanel>

                    </Grid>

                </StackPanel>


                <!-- ====================================== -->
                <!-- Adresse                                -->
                <!-- ====================================== -->

                <StackPanel Spacing="16">

                    <TextBlock Classes="form-section-title"
                               Text="Adresse" />

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="26"
                          RowSpacing="18">

                        <!-- Straße -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    Spacing="6">

                            <TextBlock Classes="form-label"
                                       Text="Straße" />

                            <TextBox Classes="form-input"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding Street, Mode=TwoWay}" />

                        </StackPanel>


                        <!-- Hausnummer -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    Spacing="6">

                            <TextBlock Classes="form-label"
                                       Text="Hausnummer" />

                            <TextBox Classes="form-input"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding StreetNumber, Mode=TwoWay}" />

                        </StackPanel>


                        <!-- PLZ -->
                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Spacing="6">

                            <TextBlock Classes="form-label"
                                       Text="PLZ" />

                            <TextBox Classes="form-input"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding PostalCode, Mode=TwoWay}" />

                        </StackPanel>


                        <!-- Ort -->
                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Spacing="6">

                            <TextBlock Classes="form-label"
                                       Text="Ort" />

                            <TextBox Classes="form-input"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding City, Mode=TwoWay}" />

                        </StackPanel>

                    </Grid>

                </StackPanel>


                <!-- ====================================== -->
                <!-- Aufnahme                               -->
                <!-- ====================================== -->

                <StackPanel Spacing="16">

                    <TextBlock Classes="form-section-title"
                               Text="Aufnahme" />

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="26"
                          RowSpacing="18">

                        <!-- Station -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    Spacing="6">

                            <TextBlock Classes="form-label"
                                       Text="Station" />

                            <TextBox Classes="form-input"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding StationId, Mode=TwoWay}" />

                        </StackPanel>


                        <!-- Zimmer -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    Spacing="6">

                            <TextBlock Classes="form-label"
                                       Text="Zimmer" />

                            <TextBox Classes="form-input"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding RoomId, Mode=TwoWay}" />

                        </StackPanel>


                        <!-- Aufnahmedatum -->
                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Spacing="6">

                            <TextBlock Classes="form-label"
                                       Text="Aufnahmedatum" />

                            <DatePicker Classes="form-input"
                                        HorizontalAlignment="Stretch"
                                        SelectedDate="{Binding AdmissionDate, Mode=TwoWay}" />

                        </StackPanel>

                    </Grid>

                </StackPanel>


                <!-- ====================================== -->
                <!-- Submit                                 -->
                <!-- ====================================== -->

                <Button Classes="btn btn-prim"
                        Content="Patient aufnehmen"
                        Command="{Binding SavePatientCommand}" />

            </StackPanel>

        </ScrollViewer>


        <!-- ====================================== -->
        <!-- Status Overlay                         -->
        <!-- ====================================== -->

        <Grid Classes="status-overlay"
              IsVisible="{Binding IsStatusVisible}">

            <!-- Success -->
            <Border Classes="status-dialog status-success"
                    IsVisible="{Binding IsSuccess}">

                <StackPanel Spacing="20">

                    <TextBlock Classes="status-success-text"
                               Text="{Binding StatusMessage}"
                               TextAlignment="Center" />

                    <Button Classes="btn btn-prim"
                            Content="OK"
                            HorizontalAlignment="Center"
                            Command="{Binding CloseStatusCommand}" />

                </StackPanel>

            </Border>


            <!-- Error -->
            <Border Classes="status-dialog status-error"
                    IsVisible="{Binding IsError}">

                <StackPanel Spacing="20">

                    <TextBlock Classes="status-error-text"
                               Text="{Binding StatusMessage}"
                               TextAlignment="Center" />

                    <Button Classes="btn btn-prim"
                            Content="OK"
                            HorizontalAlignment="Center"
                            Command="{Binding CloseStatusCommand}" />

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>