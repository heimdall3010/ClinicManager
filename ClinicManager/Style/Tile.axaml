<Styles xmlns="https://github.com/avaloniaui">

    

    <!-- Tile grid -->
    <Style Selector="Grid.patient-tiles-grid">
        <Setter Property="RowSpacing" Value="24" />
        <Setter Property="ColumnSpacing" Value="24" />
    </Style>

    <!-- Tile card -->
    <Style Selector="Border.tile-card">
        <Setter Property="Background" Value="{StaticResource Terz}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="28" />
    </Style>

    <!-- Tile content layout -->
    <Style Selector="StackPanel.tile-stack">
        <Setter Property="Spacing" Value="14" />
    </Style>

    <!-- Tile title -->
    <Style Selector="TextBlock.tile-title">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrim}" />
    </Style>

    <!-- Tile description -->
    <Style Selector="TextBlock.tile-description">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource TextSec}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    

</Styles>